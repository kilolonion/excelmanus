# ExcelManus 环境变量模板
# 来源：excelmanus/config.py 的 load_config()（及它调用的解析函数）
# 优先级：非空环境变量 > 项目 .env > $EXCELMANUS_HOME/config.env > 默认值
# 前端设置页保存的 Key 写入 ~/.excelmanus/config.env（或 EXCELMANUS_HOME），重启后仍然有效。
# 快速开始：只需填写下面三项，其余均可省略。

# ── 快速开始（必填）──────────────────────────────────────────────
# LLM API Key（必填；也可由已废弃的 EXCELMANUS_MODELS[0].api_key 继承）
EXCELMANUS_API_KEY=
# LLM API 地址（必填，须为 http/https URL；也可由 EXCELMANUS_MODELS[0].base_url 继承）
EXCELMANUS_BASE_URL=
# 模型名称（必填；Gemini 可从 BASE_URL 自动提取；也可由 EXCELMANUS_MODELS[0].model 继承）
EXCELMANUS_MODEL=

# 非 loopback 监听时必填（至少 16 字符）。默认绑定 127.0.0.1 时可留空。
# EXCELMANUS_MANAGE_TOKEN=

# ── 基础模型 ────────────────────────────────────────────────────
# 模型协议：auto / openai / openai_responses / anthropic / gemini
EXCELMANUS_PROTOCOL=auto
# 已废弃的多模型 JSON 数组；仅用于首次启动迁移或补齐上面三项
# EXCELMANUS_MODELS=
# 主循环最大迭代次数（硬上限）
EXCELMANUS_MAX_ITERATIONS=50
# 连续失败熔断阈值
EXCELMANUS_MAX_CONSECUTIVE_FAILURES=6
# 对话上下文 token 上限（未设置时按模型名推断，再回退 128000）
EXCELMANUS_MAX_CONTEXT_TOKENS=128000
# 推理深度：none / minimal / low / medium / high / xhigh / max
EXCELMANUS_THINKING_EFFORT=medium
# 精确 thinking token 预算（>0 时覆盖 effort 换算）
EXCELMANUS_THINKING_BUDGET=0
# 多条 system 注入策略：auto / merge / replace
EXCELMANUS_SYSTEM_MESSAGE_MODE=auto
# 向 API 发送 prompt_cache_key
EXCELMANUS_PROMPT_CACHE_KEY_ENABLED=true
# 激活模型视觉能力：auto / true / false。图片只交给当前激活模型阅读。
EXCELMANUS_MAIN_MODEL_VISION=auto

# Embedding 总开关（未显式设置时：配置了 API key 或 base_url 即启用）
# EXCELMANUS_EMBEDDING_ENABLED=
# Embedding API Key
EXCELMANUS_EMBEDDING_API_KEY=
# Embedding API Base URL
EXCELMANUS_EMBEDDING_BASE_URL=
# Embedding 模型名称
EXCELMANUS_EMBEDDING_MODEL=text-embedding-3-small
# 向量维度
EXCELMANUS_EMBEDDING_DIMENSIONS=1536
# Embedding 请求超时（秒）
EXCELMANUS_EMBEDDING_TIMEOUT_SECONDS=30.0

# ── 数据库 ──────────────────────────────────────────────────────
# 持久化根目录（正式仓 config.env、默认 SQLite、加密密钥都在这里）
# EXCELMANUS_HOME=~/.excelmanus
# SQLite 路径（聊天记录、记忆、向量、审批、模型档案）
EXCELMANUS_DB_PATH=~/.excelmanus/excelmanus.db
# PostgreSQL 连接 URL（设置后优先于 DB_PATH）
EXCELMANUS_DATABASE_URL=
# 是否启用聊天记录持久化
EXCELMANUS_CHAT_HISTORY_ENABLED=true
# 聊天记录独立库路径（空则使用 DB_PATH）
EXCELMANUS_CHAT_HISTORY_DB_PATH=
# Playbook 数据库路径（空则使用默认路径）
EXCELMANUS_PLAYBOOK_DB_PATH=

# ── 沙盒 ────────────────────────────────────────────────────────
# 备份 overlay / 文件检查点开关已删除。写入落在用户路径，历史在 .excelmanus/revisions
# 文件访问白名单根目录
EXCELMANUS_WORKSPACE_ROOT=.
# run_code 静态策略引擎
EXCELMANUS_CODE_POLICY_ENABLED=true
# Green 级代码自动批准
EXCELMANUS_CODE_POLICY_GREEN_AUTO=true
# Yellow 级代码自动批准
EXCELMANUS_CODE_POLICY_YELLOW_AUTO=true
# 额外安全模块白名单（逗号分隔）
EXCELMANUS_CODE_POLICY_EXTRA_SAFE=
# 额外阻断模块黑名单（逗号分隔）
EXCELMANUS_CODE_POLICY_EXTRA_BLOCKED=
# 是否允许 command hook 执行
EXCELMANUS_HOOKS_COMMAND_ENABLED=false
# command hook 白名单前缀（逗号分隔）
EXCELMANUS_HOOKS_COMMAND_ALLOWLIST=
# command hook 超时（秒）
EXCELMANUS_HOOKS_COMMAND_TIMEOUT_SECONDS=10
# hook 输出截断长度
EXCELMANUS_HOOKS_OUTPUT_MAX_CHARS=32000
# 工具参数 JSON Schema 校验：off / shadow / enforce
EXCELMANUS_TOOL_SCHEMA_VALIDATION_MODE=off
# enforce 模式灰度比例 0..100
EXCELMANUS_TOOL_SCHEMA_VALIDATION_CANARY_PERCENT=100
# 路径参数必须为相对路径且禁止 ..
EXCELMANUS_TOOL_SCHEMA_STRICT_PATH=false

# ── 渠道 ────────────────────────────────────────────────────────
# load_config() 不读取 Telegram/QQ/飞书 token 或 EXCELMANUS_CHANNELS。
# 渠道开关与密钥由渠道模块自行读取，不在本文件列出。
# 公开访问 URL（Bot 生成下载链接时使用）
EXCELMANUS_PUBLIC_URL=

# ── 其他 ────────────────────────────────────────────────────────
# API 会话空闲超时（秒）
EXCELMANUS_SESSION_TTL_SECONDS=1800
# API 最大并发会话数
EXCELMANUS_MAX_SESSIONS=1000
# 集中数据目录（空字符串；运行时注释约定为 ~/.excelmanus/data）
EXCELMANUS_DATA_ROOT=
# 部署模式：auto / standalone / server（auto 与未知值均为 standalone；server 必须显式指定）
EXCELMANUS_DEPLOY_MODE=auto
# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
EXCELMANUS_LOG_LEVEL=INFO
# API CORS 允许来源（逗号分隔）
EXCELMANUS_CORS_ALLOW_ORIGINS=http://localhost:3000
# CLI 布局：dashboard / classic
EXCELMANUS_CLI_LAYOUT_MODE=dashboard
# 文本回复门禁：off / soft
EXCELMANUS_GUARD_MODE=off

# Skillpack
# 内置 Skillpacks 目录（未设置时为 excelmanus/skillpacks/system 的绝对路径）
# EXCELMANUS_SKILLS_SYSTEM_DIR=
# 用户级 Skillpacks 目录
EXCELMANUS_SKILLS_USER_DIR=~/.excelmanus/skillpacks
# 项目级 Skillpacks 目录（未设置时为 <workspace_root>/.excelmanus/skillpacks）
# EXCELMANUS_SKILLS_PROJECT_DIR=
# 技能正文字符预算，0 表示不限制
EXCELMANUS_SKILLS_CONTEXT_CHAR_BUDGET=12000
# 是否启用通用目录发现
EXCELMANUS_SKILLS_DISCOVERY_ENABLED=true
# 是否扫描 cwd→workspace 祖先链 .agents/skills
EXCELMANUS_SKILLS_DISCOVERY_SCAN_WORKSPACE_ANCESTORS=true
# 是否发现 .agents/skills
EXCELMANUS_SKILLS_DISCOVERY_INCLUDE_AGENTS=true
# 是否发现外部工具目录
EXCELMANUS_SKILLS_DISCOVERY_SCAN_EXTERNAL_TOOL_DIRS=true
# 额外扫描目录（逗号分隔）
EXCELMANUS_SKILLS_DISCOVERY_EXTRA_DIRS=
# ClawHub 技能市场
EXCELMANUS_CLAWHUB_ENABLED=true
EXCELMANUS_CLAWHUB_REGISTRY_URL=https://clawhub.ai
EXCELMANUS_CLAWHUB_PREFER_CLI=true

# 工具结果与大文件
EXCELMANUS_TOOL_RESULT_HARD_CAP_CHARS=12000
EXCELMANUS_LARGE_EXCEL_THRESHOLD_BYTES=8388608

# MCP / 搜索
EXCELMANUS_MCP_SHARED_MANAGER=false
EXCELMANUS_EXA_SEARCH=true
EXCELMANUS_SEARCH_DEFAULT=exa
EXCELMANUS_EXA_API_KEY=
EXCELMANUS_TAVILY_API_KEY=
EXCELMANUS_BRAVE_API_KEY=

# 号池（默认关闭）
EXCELMANUS_POOL_ENABLED=false
EXCELMANUS_POOL_AUTO_ENABLED=false
EXCELMANUS_POOL_AUTO_INTERVAL=60
EXCELMANUS_POOL_AUTO_COOLDOWN=300
EXCELMANUS_POOL_AUTO_HYSTERESIS_DELTA=0.12
EXCELMANUS_POOL_AUTO_MIN_DWELL=180
EXCELMANUS_POOL_AUTO_BREAKER_OPEN=120
EXCELMANUS_POOL_AUTO_BREAKER_THRESHOLD=5

# 子代理
EXCELMANUS_SUBAGENT_ENABLED=true
EXCELMANUS_PARALLEL_READONLY_TOOLS=true
# 兼容旧配置；子代理循环不再用作回合预算
EXCELMANUS_SUBAGENT_MAX_ITERATIONS=120
EXCELMANUS_SUBAGENT_MAX_CONSECUTIVE_FAILURES=6
EXCELMANUS_SUBAGENT_TIMEOUT_SECONDS=600
EXCELMANUS_PARALLEL_SUBAGENT_MAX=3
EXCELMANUS_SUBAGENT_USER_DIR=~/.excelmanus/agents
# 未设置时为 <workspace_root>/.excelmanus/agents
# EXCELMANUS_SUBAGENT_PROJECT_DIR=

# 持久记忆
EXCELMANUS_MEMORY_ENABLED=true
EXCELMANUS_MEMORY_DIR=~/.excelmanus/memory
EXCELMANUS_MEMORY_AUTO_LOAD_LINES=200
# 0 = 禁用后台周期记忆抽取（默认）
EXCELMANUS_MEMORY_AUTO_EXTRACT_INTERVAL=0
EXCELMANUS_MEMORY_SEMANTIC_TOP_K=10
EXCELMANUS_MEMORY_SEMANTIC_THRESHOLD=0.3
EXCELMANUS_MEMORY_SEMANTIC_FALLBACK_RECENT=5
EXCELMANUS_REGISTRY_SEMANTIC_TOP_K=5
EXCELMANUS_REGISTRY_SEMANTIC_THRESHOLD=0.25

# 上下文摘要 / 压缩
# 旧式 summarize_and_trim 兜底（默认关，compaction 已覆盖）
EXCELMANUS_SUMMARIZATION_ENABLED=false
EXCELMANUS_SUMMARIZATION_THRESHOLD_RATIO=0.8
EXCELMANUS_SUMMARIZATION_KEEP_RECENT_TURNS=3
EXCELMANUS_COMPACTION_ENABLED=true
EXCELMANUS_COMPACTION_THRESHOLD_RATIO=0.85
EXCELMANUS_COMPACTION_KEEP_RECENT_TURNS=5
EXCELMANUS_COMPACTION_MAX_SUMMARY_TOKENS=1500

# 历史会话感知
# 会话结束自动摘要（默认关）
EXCELMANUS_SESSION_SUMMARY_ENABLED=false
EXCELMANUS_SESSION_SUMMARY_MIN_TURNS=3
EXCELMANUS_SESSION_SUMMARY_INJECT_TOP_K=3
EXCELMANUS_SESSION_SUMMARY_MAX_TOKENS=800

# Playbook
EXCELMANUS_PLAYBOOK_ENABLED=false
EXCELMANUS_PLAYBOOK_MAX_BULLETS=500

