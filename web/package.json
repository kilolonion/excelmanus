{
  "name": "web",
  "version": "1.8.1",
  "private": true,
  "scripts": {
    "sync-version": "node -e \"const fs=require('fs');const t=fs.readFileSync('../pyproject.toml','utf8');const m=t.match(/^version\\s*=\\s*\\\"([^\\\"]+)\\\"/m);if(m){const p=JSON.parse(fs.readFileSync('package.json','utf8'));if(p.version!==m[1]){p.version=m[1];fs.writeFileSync('package.json',JSON.stringify(p,null,2)+'\\n');console.log('synced version to '+m[1])}}\"",
    "predev": "npm run sync-version",
    "prebuild": "npm run sync-version && npm run build:preview",
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "build:webpack": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:preview": "node scripts/build-workbook-preview.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "@univerjs/core": {
      "nanoid": "5.1.16"
    },
    "brace-expansion@^1.1.0": "1.1.21"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.19",
    "@univerjs/preset-docs-core": "^0.15.5",
    "@univerjs/preset-sheets-advanced": "^0.15.5",
    "@univerjs/preset-sheets-core": "^0.15.5",
    "@univerjs/presets": "^0.15.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.3",
    "highlight.js": "^11.11.1",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.575.0",
    "next": "16.3.5",
    "qrcode.react": "4.2.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-dropzone": "^15.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.27.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^29.1.1",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
